{
  "name": "yogi-ai",
  "version": "1.0.0",
  "description": "Generate, review, and safely execute PostgreSQL seed data from natural-language requests.",
  "main": "server/server.js",
  "type": "module",
  "dependencies": {
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/material": "^6.1.8",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "css-loader": "^7.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "html-webpack-plugin": "^5.6.3",
    "jest-environment-jsdom": "^29.7.0",
    "openai": "^4.73.0",
    "pg": "^8.13.1",
    "pgsql-ast-parser": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "style-loader": "^4.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "webpack --mode production",
    "clean": "rm -rf build coverage",
    "typecheck": "tsc --project tsconfig.json",
    "dev": "webpack serve --open --port 8080",
    "devc": "concurrently \"npm:dev\" \"nodemon server/index.js\"",
    "test": "jest",
    "testc": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write README.md \"docs/**/*.md\" \".github/**/*.yml\" package.json tsconfig.json eslint.config.js docker-compose.yml",
    "format:check": "prettier --check README.md \"docs/**/*.md\" \".github/**/*.yml\" package.json tsconfig.json eslint.config.js docker-compose.yml",
    "deps:check": "npm audit --omit=dev",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test -- --runInBand && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmeyer23/dataWizard.git"
  },
  "author": "Anna Kempel, Aaron Jacobs, Alex Grimm, Mason Meyer",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mmeyer23/dataWizard/issues"
  },
  "homepage": "https://github.com/mmeyer23/dataWizard#readme",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "eslint": "^9.39.4",
    "file-loader": "^6.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
