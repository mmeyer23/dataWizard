# Server
PORT=3000
OPENAI_API_KEY=replace-with-a-server-side-key
# Set true only for local UI evaluation; demo mode never calls OpenAI or a database.
DEMO_MODE=false

# Optional database execution defaults. Never commit real credentials.
DATABASE_URL=postgres://data_wizard_runner:replace-me@localhost:5432/data_wizard_demo
DATA_WIZARD_TEST_DATABASE_URL=postgres://data_wizard_runner:replace-me@localhost:5432/data_wizard_demo

# Local browser/API boundary
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
SHUTDOWN_GRACE_MS=10000
