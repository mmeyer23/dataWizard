{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true
  },
  "include": [
    "shared/**/*.js",
    "server/config.js",
    "server/generation/**/*.js"
  ],
  "exclude": ["**/*.test.js"]
}
